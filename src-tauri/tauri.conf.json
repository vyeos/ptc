{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PTC Fee",
  "version": "0.1.7",
  "identifier": "com.vyeos.ptc",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PTC Fee",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxRTIzRDUwNzVGN0MzRQpSV1ErZkY4SDFTTWVCbi9qcUlua09YOFpWUndyTEtSVXhCbGpaKzNGOUhMaHhWVWh4TklORnFwUgo=",
      "endpoints": [
        "https://github.com/vyeos/ptc/releases/latest/download/latest.json"
      ]
    }
  }
}
